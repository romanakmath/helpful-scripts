#!/usr/bin/env bash
# pi-session-html — find a pi coding-agent session by a phrase and open it as HTML.
#
# Usage:
#   pi-session-html "phrase"              # search, pick, confirm, open HTML
#   pi-session-html "phrase" out.html     # same, but write HTML to out.html
#   pi-session-html "phrase" -y           # no prompts: use first match, no confirm
#   pi-session-html "phrase" --text       # print readable text instead of HTML
#
# HTML files are written to /tmp/pi-sessions/ as
#   <session-date>_<session-title>.html
# where the title is the session name (pi-web index), falling back to the
# first user message. List and reopen them with the `pi-sessions` script.
#
# Steps it automates:
#   1. grep all pi session files (~/.pi/agent/sessions/**/*.jsonl) for the phrase
#   2. list matches (date, size, context snippet) and let you pick one
#   3. after confirmation, export the session with `pi --export` to HTML
#   4. open the HTML in the default browser
set -euo pipefail

SESSIONS_DIR="${HOME}/.pi/agent/sessions"
AUTO=0
MODE=html
PHRASE=""
OUT=""

for arg in "$@"; do
  case "$arg" in
    -y|--yes)   AUTO=1 ;;
    --text)     MODE=text ;;
    -h|--help)  sed -n '2,14p' "$0"; exit 0 ;;
    *)
      if [[ -z "$PHRASE" ]]; then PHRASE="$arg"
      elif [[ -z "$OUT" && "$arg" != -* ]]; then OUT="$arg"
      fi ;;
  esac
done

if [[ -z "$PHRASE" ]]; then
  sed -n '2,14p' "$0"
  exit 1
fi

# ── 1. Search ────────────────────────────────────────────────────────────────
echo "Searching sessions for: \"$PHRASE\" …"
MATCHES=()
while IFS= read -r m; do MATCHES+=("$m"); done < <(grep -rilF --include='*.jsonl' -e "$PHRASE" "$SESSIONS_DIR" 2>/dev/null | sort || true)

if [[ ${#MATCHES[@]} -eq 0 ]]; then
  echo "No session contains \"$PHRASE\"."
  exit 1
fi

# ── 2. List matches, pick one ────────────────────────────────────────────────
snippet() {  # snippet <file> — first context around the phrase (plain text)
  python3 - "$1" "$PHRASE" <<'PY'
import json, sys
path, phrase = sys.argv[1], sys.argv[2].lower()
with open(path, errors="replace") as f:
    for line in f:
        if phrase not in line.lower():
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue
        msg = e.get("message", {})
        role = msg.get("role", e.get("type", "?"))
        content = msg.get("content")
        texts = []
        if isinstance(content, str):
            texts.append(content)
        elif isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "text":
                    texts.append(b.get("text", ""))
        blob = "\n".join(texts).replace("\n", " ")
        i = blob.lower().find(phrase)
        if i >= 0:
            s, a = max(0, i - 50), min(len(blob), i + len(phrase) + 60)
            print(f"      …{blob[s:a]}…  [{role}]")
            break
PY
}

if [[ ${#MATCHES[@]} -eq 1 ]] && [[ $AUTO -eq 1 ]]; then
  PICK=0
else
  echo
  echo "Found ${#MATCHES[@]} session(s):"
  for i in "${!MATCHES[@]}"; do
    f="${MATCHES[$i]}"
    date=$(basename "$f" | cut -c1-19 | tr 'T' ' ')
    size=$(du -h "$f" | cut -f1 | tr -d ' ')
    printf "  [%d] %s   (%s)\n" $((i + 1)) "$date" "$size"
    snippet "$f"
  done
  echo
  if [[ $AUTO -eq 1 ]]; then
    PICK=0
    echo "(auto-picking first match)"
  else
    read -rp "Which session? [1-${#MATCHES[@]}, Enter=1, q=quit] " ans
    [[ "${ans:-1}" =~ ^[qQ]$ ]] && exit 0
    PICK=$(( ${ans:-1} - 1 ))
    if (( PICK < 0 || PICK >= ${#MATCHES[@]} )); then
      echo "Invalid choice."; exit 1
    fi
  fi
fi
FILE="${MATCHES[$PICK]}"
echo
echo "Selected: $FILE"

# ── 3. Confirm ───────────────────────────────────────────────────────────────
if [[ $AUTO -eq 0 ]]; then
  read -rp "Proceed? [Y/n] " yn
  [[ "${yn:-y}" =~ ^[nN] ]] && exit 0
fi

# ── 4. Render ────────────────────────────────────────────────────────────────
if [[ "$MODE" == text ]]; then
  exec pi-read-session "$FILE" "$PHRASE"
fi

session_title() {  # session_title <file> → filename-safe title
  python3 - "$1" <<'PY'
import json, os, re, sys
path = sys.argv[1]

name = ""
idx_path = os.path.expanduser("~/.pi/agent/pi-web-session-index.json")
try:
    idx = json.load(open(idx_path))
    info = idx.get("entries", {}).get(path, {}).get("info", {})
    name = (info.get("name") or "").strip()
except Exception:
    pass

if not name:
    with open(path, errors="replace") as f:
        for line in f:
            try:
                e = json.loads(line)
            except Exception:
                continue
            if e.get("type") != "message":
                continue
            m = e.get("message", {})
            if m.get("role") != "user":
                continue
            c = m.get("content")
            texts = []
            if isinstance(c, str):
                texts.append(c)
            elif isinstance(c, list):
                for b in c:
                    if isinstance(b, dict) and b.get("type") == "text":
                        texts.append(b.get("text", ""))
            t = " ".join(" ".join(texts).split())
            if t and not t.startswith("<"):
                name = t
                break

if not name:
    name = os.path.basename(path)

name = name[:60]
name = re.sub(r"[^\w.-]+", "-", name, flags=re.UNICODE).strip("-.")
print(name or "session")
PY
}

if [[ -z "$OUT" ]]; then
  mkdir -p /tmp/pi-sessions
  date_part=$(basename "$FILE" | cut -c1-19)
  title=$(session_title "$FILE")
  OUT="/tmp/pi-sessions/${date_part}_${title}.html"
fi
pi --export "$FILE" "$OUT"

# ── 5. Inject enhancements (collapsible thinking + code blocks) ─────────
inject_enhancers() {  # inject_enhancers <html-file>
  python3 - "$1" <<'PY'
import sys

path = sys.argv[1]
html = open(path, encoding="utf-8").read()
if 'id="pcx-script"' in html:
    sys.exit(0)  # already injected

STYLE = """<style id=\"pcx-style\">
.pc-wrap{margin:.5em 0;border:1px solid var(--border,#999);border-radius:6px;overflow:hidden}
.pc-head{cursor:pointer;user-select:none;padding:3px 10px;font-size:11px;font-family:ui-monospace,Menlo,monospace;opacity:.65;background:rgba(127,127,127,.08)}
.pc-head:hover{opacity:1}
.pc-body{overflow:hidden}
.pc-wrap.collapsed .pc-body{max-height:11em;-webkit-mask-image:linear-gradient(#000 60%,transparent);mask-image:linear-gradient(#000 60%,transparent)}
.pc-wrap.collapsed .pc-body pre{margin-bottom:0}
.pcx-btn{position:fixed;bottom:14px;right:14px;z-index:99999;cursor:pointer;padding:6px 12px;border:1px solid var(--border,#999);border-radius:999px;font-size:12px;background:rgba(127,127,127,.12);backdrop-filter:blur(4px)}
.pcx-btn:hover{background:rgba(127,127,127,.25)}
</style>"""

SCRIPT = """<script id=\"pcx-script\">
(function(){
'use strict';
function sel(){return window.getSelection().toString()}
// thinking: click a block to toggle it
 document.addEventListener('click',function(e){
  var tb=e.target.closest?e.target.closest('.thinking-block'):null;
  if(!tb||sel())return;
  var txt=tb.querySelector('.thinking-text'),col=tb.querySelector('.thinking-collapsed');
  if(!txt)return;
  var collapsed=txt.style.display==='none';
  txt.style.display=collapsed?'':'none';
  if(col)col.style.display=collapsed?'none':'block';
});
// code blocks: wrap and collapse
function langOf(pre){
  var c=pre.querySelector('code[class*="language-"]');
  var m=c&&c.className.match(/language-([\\w+#.-]+)/);
  return m?m[1]:'code';
}
function setHead(head,collapsed){
  head.textContent=head.textContent.replace(/^[\\u25b8\\u25be]/,collapsed?'\\u25b8':'\\u25be')
    .replace(/expand|collapse/,collapsed?'expand':'collapse');
}
function enhance(pre){
  if(pre.getAttribute('data-pcx'))return;
  pre.setAttribute('data-pcx','1');
  if(pre.closest&&pre.closest('.pc-wrap'))return;
  var wrap=document.createElement('div');wrap.className='pc-wrap collapsed';
  var head=document.createElement('div');head.className='pc-head';
  var n=pre.textContent.split('\\n').length;
  head.textContent='\\u25b8 '+langOf(pre)+' \\u00b7 '+n+' lines \\u00b7 click to expand';
  var body=document.createElement('div');body.className='pc-body';
  pre.parentNode.insertBefore(wrap,pre);
  body.appendChild(pre);wrap.appendChild(head);wrap.appendChild(body);
  head.addEventListener('click',function(){
    if(sel())return;
    wrap.classList.toggle('collapsed');
    setHead(head,wrap.classList.contains('collapsed'));
  });
}
var pending=new Set(),scheduled=false;
function flush(){scheduled=false;pending.forEach(enhance);pending.clear()}
function queue(pre){pending.add(pre);if(!scheduled){scheduled=true;requestAnimationFrame(flush)}}
var mo=new MutationObserver(function(muts){
  muts.forEach(function(m){
    (m.addedNodes||[]).forEach(function(n){
      if(!n.querySelectorAll)return;
      if(n.tagName==='PRE')queue(n);
      else Array.prototype.forEach.call(n.querySelectorAll('pre'),function(p){if(!p.closest('.pc-wrap'))queue(p)});
    });
  });
});
mo.observe(document.documentElement,{childList:true,subtree:true});
// thinking: default collapsed as blocks appear
var tmo=new MutationObserver(function(muts){
  muts.forEach(function(m){
    (m.addedNodes||[]).forEach(function(n){
      if(!n.querySelectorAll)return;
      var tbs=n.classList&&n.classList.contains('thinking-block')?[n]:n.querySelectorAll('.thinking-block');
      Array.prototype.forEach.call(tbs,function(tb){
        if(tb.getAttribute('data-pcx'))return;
        tb.setAttribute('data-pcx','1');
        var txt=tb.querySelector('.thinking-text'),col=tb.querySelector('.thinking-collapsed');
        if(txt){txt.style.display='none';if(col)col.style.display='block';}
      });
    });
  });
});
tmo.observe(document.documentElement,{childList:true,subtree:true});
// floating collapse/expand-all button
window.addEventListener('DOMContentLoaded',function(){
  var btn=document.createElement('div');btn.className='pcx-btn';btn.textContent='\\u25b8 code';
  btn.addEventListener('click',function(){
    if(sel())return;
    var wraps=document.querySelectorAll('.pc-wrap');
    var anyOpen=Array.prototype.some.call(wraps,function(w){return !w.classList.contains('collapsed')});
    Array.prototype.forEach.call(wraps,function(w){
      w.classList.toggle('collapsed',anyOpen);
      var h=w.querySelector('.pc-head');if(h)setHead(h,anyOpen);
    });
    btn.textContent=anyOpen?'\\u25b8 code':'\\u25be code';
  });
  document.body.appendChild(btn);
});
})();
</script>"""

if "</head>" in html:
    html = html.replace("</head>", STYLE + "</head>", 1)
else:
    html = STYLE + html
if "</body>" in html:
    html = html.replace("</body>", SCRIPT + "</body>", 1)
else:
    html = html + SCRIPT
open(path, "w", encoding="utf-8").write(html)
print("enhancements injected: collapsible thinking + code blocks")
PY
}

if [[ -f "$OUT" ]]; then
  inject_enhancers "$OUT"
fi

echo "Exported: $OUT"

# ── 5. Open in browser ───────────────────────────────────────────────────────
if command -v open >/dev/null 2>&1; then
  open "$OUT"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$OUT"
fi
