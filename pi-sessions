#!/usr/bin/env bash
# pi-sessions — list exported session HTML files and open one in the browser.
#
# Companion to `pi-session-html`, which writes exports to /tmp/pi-sessions/ as
#   <session-date>_<session-title>.html
#
# Usage:
#   pi-sessions            # list files newest first, pick one, open it
#   pi-sessions 2          # open the 2nd file in the list directly
#   pi-sessions -y         # open the newest file, no prompt
#   pi-sessions -l         # list only, don't open
set -euo pipefail

DIR="/tmp/pi-sessions"
LIST_ONLY=0
AUTO=0
PICK_ARG=""

for arg in "$@"; do
  case "$arg" in
    -l|--list)  LIST_ONLY=1 ;;
    -y|--yes)   AUTO=1 ;;
    -h|--help)  sed -n '2,12p' "$0"; exit 0 ;;
    '')         ;;
    *)          if [[ "$arg" =~ ^[0-9]+$ ]]; then PICK_ARG="$arg"; else
                  echo "Unknown argument: $arg" >&2; exit 1
                fi ;;
  esac
done

if [[ ! -d "$DIR" ]] || ! compgen -G "$DIR/*.html" >/dev/null; then
  echo "No exported sessions in $DIR — run pi-session-html \"phrase\" first."
  exit 1
fi

# newest first
FILES=()
while IFS= read -r f; do FILES+=("$f"); done < <(ls -t "$DIR"/*.html)
N=${#FILES[@]}

echo "Exported sessions in $DIR (newest first):"
echo
for i in "${!FILES[@]}"; do
  f="${FILES[$i]}"
  name=$(basename "${f%.html}")
  size=$(du -h "$f" | cut -f1 | tr -d ' ')
  mod=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$f" 2>/dev/null || date -r "$f" '+%Y-%m-%d %H:%M')
  printf "  [%d] %s   %s   (%s)\n" $((i + 1)) "$mod" "$name" "$size"
done
echo

if [[ $LIST_ONLY -eq 1 ]]; then
  exit 0
fi

# decide which file to open
if [[ -n "$PICK_ARG" ]]; then
  PICK=$(( PICK_ARG - 1 ))
elif [[ $AUTO -eq 1 ]]; then
  PICK=0
else
  read -rp "Which file? [1-$N, Enter=1, q=quit] " ans
  [[ "${ans:-1}" =~ ^[qQ]$ ]] && exit 0
  PICK=$(( ${ans:-1} - 1 ))
fi

if (( PICK < 0 || PICK >= N )); then
  echo "Invalid choice."; exit 1
fi

FILE="${FILES[$PICK]}"
echo "Opening: $FILE"
if command -v open >/dev/null 2>&1; then
  open "$FILE"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$FILE"
fi
