#!/usr/bin/env bash
# pi-session-import — put a pi session starting at a chosen point into Pi Web,
# trimmed so the passage is the FIRST (topmost) rectangle in the chat minimap.
#
# Same search flow as pi-session-html, but instead of HTML it writes a trimmed
# copy of the session into the review folder. The folder is symlinked from
# ~/.pi/agent/sessions/--imports-- so Pi Web discovers the files, and its path
# is stamped as the session's cwd so Pi Web groups imports under their own
# folder "pi-review-sessions". Refresh Pi Web and the import appears within
# ~30 s.
#
# Pi Web display rules (why the trim works):
#   - GET /api/sessions/<id>/context returns the TAIL of the active branch:
#     the last 50 "counted" entries (user+assistant messages + compactions;
#     tool results/other entries ride along free). ?tail=N overrides, cap 1000.
#   - The session opens scrolled to the BOTTOM (latest message).
#   - The minimap rail (right edge) draws one rectangle per "turn" = one user
#     message + its assistant replies, and only for messages loaded in the DOM.
#     Clicking a rectangle scrolls that turn to ~30% from the top.
#   - Therefore: an import whose TOTAL counted entries ≤ 50 loads completely
#     on open, and its topmost rectangle is the first turn = the phrase turn.
#
# The import starts at the TURN containing the phrase (walks back to the user
# message that began that turn, so the phrase's assistant reply is reachable
# via the minimap preview "A" button) and keeps up to -n counted messages
# (default 50), cutting whole turns from the END when needed.
#
# Output: the final summary prints a `STAT counted=… turns=…` line, then the
# label "The exported new JSONL file is saved in:" followed by the full path of
# the imported .jsonl — paste that path into another conversation's prompt.
#
# Usage:
#   pi-session-import "phrase"            # search, pick, import
#   pi-session-import "phrase" -y         # no picker (auto-picks first match)
#   pi-session-import "phrase" -n 50      # max counted messages (default 50;
#                                         #   >50 breaks the topmost-rectangle
#                                         #   guarantee — Pi Web loads last 50)
set -euo pipefail

SESSIONS_DIR="${HOME}/.pi/agent/sessions"
# Physically stores imports; symlinked to the review folder below.
IMPORT_DIR="${SESSIONS_DIR}/--imports--"
# Label + agent working directory for imports. Pi Web groups sessions by this
# path and runs the agent inside it, so it must exist. Kept as a real folder
# (not /tmp) so it survives reboots and the agent can reach its files.
IMPORT_PROJECT="${PI_SESSION_IMPORT_PROJECT:-/Users/roman/Dropbox/Code/trading/pi-review-sessions}"
PI_WEB_URL="http://127.0.0.1:30141"
AUTO=0
MAX_MESSAGES=50
PHRASE=""

for arg in "$@"; do
  case "$arg" in
    -y|--yes)  AUTO=1 ;;
    -n|--max-messages) MAX_MESSAGES="$2"; shift 2 ;;
    -n*) MAX_MESSAGES="${arg#-n}" ;;
    -h|--help) sed -n '2,34p' "$0"; exit 0 ;;
    *) if [[ -z "$PHRASE" && "$arg" != -* ]]; then PHRASE="$arg"; fi ;;
  esac
done

if [[ -z "$PHRASE" ]]; then
  sed -n '2,34p' "$0"
  exit 1
fi
if ! [[ "$MAX_MESSAGES" =~ ^[0-9]+$ ]] || (( MAX_MESSAGES < 1 )); then
  echo "Invalid -n value: $MAX_MESSAGES" >&2
  exit 1
fi

# ── 1. Search ────────────────────────────────────────────────────────────────
echo "Searching sessions for: \"$PHRASE\" …"
MATCHES=()
while IFS= read -r m; do MATCHES+=("$m"); done < <(grep -rilF --include='*.jsonl' -e "$PHRASE" "$SESSIONS_DIR" 2>/dev/null | grep -v '/--imports--/' | sort || true)

if [[ ${#MATCHES[@]} -eq 0 ]]; then
  echo "No session contains \"$PHRASE\"."
  exit 1
fi

# ── 2. List matches, pick one ────────────────────────────────────────────────
snippet() {  # snippet <file> — first context around the phrase
  python3 - "$1" "$PHRASE" <<'PY'
import json, sys
path, phrase = sys.argv[1], sys.argv[2].lower()
with open(path, errors="replace") as f:
    for line in f:
        if phrase not in line.lower():
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue
        msg = e.get("message", {})
        role = msg.get("role", e.get("type", "?"))
        content = msg.get("content")
        texts = []
        if isinstance(content, str):
            texts.append(content)
        elif isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "text":
                    texts.append(b.get("text", ""))
        blob = "\n".join(texts).replace("\n", " ")
        i = blob.lower().find(phrase)
        if i >= 0:
            s, a = max(0, i - 50), min(len(blob), i + len(phrase) + 60)
            print(f"      …{blob[s:a]}…  [{role}]")
            break
PY
}

session_meta() {  # session_meta <file> — "cwd  (N msgs)" for the picker
  python3 - "$1" <<'PY'
import json, os, sys
path = sys.argv[1]
cwd = "?"
try:
    with open(path, errors="replace") as f:
        first = json.loads(f.readline())
    cwd = first.get("cwd") or "?"
except Exception:
    pass
home = os.path.expanduser("~")
if cwd.startswith(home):
    cwd = "~" + cwd[len(home):]
msgs = 0
with open(path, errors="replace") as f:
    for line in f:
        if '"type":"message"' in line or '"type": "message"' in line:
            msgs += 1
print(f"{cwd}  ({msgs} msgs)")
PY
}

if [[ ${#MATCHES[@]} -eq 1 ]] && [[ $AUTO -eq 1 ]]; then
  PICK=0
else
  echo
  echo "Found ${#MATCHES[@]} session(s):"
  for i in "${!MATCHES[@]}"; do
    f="${MATCHES[$i]}"
    date=$(basename "$f" | cut -c1-19 | tr 'T' ' ')
    size=$(du -h "$f" | cut -f1 | tr -d ' ')
    meta=$(session_meta "$f")
    printf "  [%d] %s   (%s)   %s\n" $((i + 1)) "$date" "$size" "$meta"
    snippet "$f"
  done
  echo
  if [[ $AUTO -eq 1 ]]; then
    PICK=0
    echo "(auto-picking first match)"
  else
    read -rp "Which session? [1-${#MATCHES[@]}, Enter=1, q=quit] " ans
    [[ "${ans:-1}" =~ ^[qQ]$ ]] && exit 0
    PICK=$(( ${ans:-1} - 1 ))
    if (( PICK < 0 || PICK >= ${#MATCHES[@]} )); then
      echo "Invalid choice."; exit 1
    fi
  fi
fi
FILE="${MATCHES[$PICK]}"
echo
echo "Selected: $FILE"

# ── 3. Build trimmed session and drop it into Pi Web's sessions folder ──────
# Pi Web checks that the project directory exists before running an agent.
mkdir -p "$IMPORT_PROJECT"

OUT=$(python3 - "$FILE" "$PHRASE" "$IMPORT_DIR" "$IMPORT_PROJECT" "$MAX_MESSAGES" <<'PY'
import json, os, re, sys, uuid

src, phrase, import_dir, import_project, max_n = (
    sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], int(sys.argv[5]))
needle = phrase.lower()

entries = []
with open(src, errors="replace") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            entries.append(json.loads(line))
        except Exception:
            continue

# active branch: walk from the last entry back through parentId
by_id = {e.get("id"): e for e in entries if e.get("id")}
last = next((e for e in reversed(entries) if e.get("id")), None)
chain, cur, seen = [], last, set()
while cur and cur.get("id") not in seen:
    seen.add(cur.get("id"))
    chain.append(cur)
    cur = by_id.get(cur.get("parentId"))
chain.reverse()
# drop the session header entry — we write our own
chain = [e for e in chain if e.get("type") != "session"]

def is_counted(e):
    # Pi Web's tail counts user/assistant messages + compactions
    if e.get("type") == "compaction":
        return True
    if e.get("type") == "message":
        return e.get("message", {}).get("role") in ("user", "assistant")
    return False

def is_turn_start(e):
    # Pi Web minimap: a turn starts at a user message, a compaction, or a
    # subagent-notification custom message; assistant replies join that turn.
    if e.get("type") == "message":
        return e.get("message", {}).get("role") == "user"
    if e.get("type") == "compaction":
        return True
    if e.get("type") == "custom_message":
        return e.get("customType") in ("pi-web:subagent-notification", "compaction")
    return False

# start at the first active-branch entry containing the phrase
start = None
for i, e in enumerate(chain):
    if needle in json.dumps(e).lower():
        start = i
        break
if start is None:
    print("(phrase not on active branch — importing from session start)", file=sys.stderr)
    start = 0

# walk back to the start of the turn containing the phrase, so the phrase's
# assistant reply is attached to a minimap rectangle (preview "A" button)
while start > 0 and not is_turn_start(chain[start]):
    start -= 1

# keep whole turns from there, until the counted-message budget is used up
kept, counted, turns = [], 0, 0
for i in range(start, len(chain)):
    e = chain[i]
    if is_turn_start(e) and turns > 0 and counted >= max_n:
        break  # budget full — cut at this turn boundary
    kept.append(e)
    if is_turn_start(e):
        turns += 1
    if is_counted(e):
        counted += 1

dropped = sum(1 for e in chain[start:] if is_counted(e)) - counted

header = next((dict(e) for e in entries if e.get("type") == "session"),
              {"type": "session", "version": 3})
header["timestamp"] = kept[0].get("timestamp") or header.get("timestamp")
# Pi Web groups sessions by cwd — use the dedicated imports project so the
# import shows up as its own folder, never inside the source project.
header["cwd"] = import_project
header.pop("parentSessionPath", None)
header["name"] = "IMPORT: " + phrase.strip()[:60]

first = dict(kept[0])
first["parentId"] = None  # hasMore=false → nothing hidden behind "load earlier"
out_entries = [header, first] + kept[1:]

os.makedirs(import_dir, exist_ok=True)
slug = re.sub(r"[^\w.-]+", "-", phrase.strip()[:40]).strip("-.") or "session"
date_part = os.path.basename(src)[:19]
out_path = os.path.join(import_dir, f"{date_part}_import-{slug}.jsonl")

# Stable session id derived from the output path. Re-importing the same
# source+phrase rewrites the same file with the SAME id — Pi Web merges its
# session list by id, so a fresh uuid4 per run would leave every previously
# opened copy behind as a duplicate entry.
header["id"] = str(uuid.uuid5(uuid.NAMESPACE_URL, "pi-session-import:" + out_path))
with open(out_path, "w", encoding="utf-8") as w:
    for e in out_entries:
        w.write(json.dumps(e, ensure_ascii=False) + "\n")

print(out_path)
print(f"STAT counted={counted} turns={turns} dropped_end={dropped} "
      f"phrase_is_first_turn={'yes' if is_turn_start(kept[0]) else 'no'} "
      f"start_ts={kept[0].get('timestamp','?')}")
PY
)

# python prints two stdout lines: the output path, then one STAT line
OUT_PATH=$(echo "$OUT" | head -1)
STATS=$(echo "$OUT" | grep '^STAT ') || STATS=""

COUNTED=$(echo "$STATS" | sed -n 's/.*counted=\([0-9]*\).*/\1/p')
DROPPED=$(echo "$STATS" | sed -n 's/.*dropped_end=\([0-9]*\).*/\1/p')
FIRST_TURN=$(echo "$STATS" | sed -n 's/.*phrase_is_first_turn=\([a-z]*\).*/\1/p')

# summary — the full JSONL path comes straight after the STAT line so it can
# be pasted into another conversation's prompt
echo "$STATS"
echo
echo "The exported new JSONL file is saved in:"
echo "$OUT_PATH"
echo

if [[ -n "$COUNTED" && "$FIRST_TURN" == "yes" && "$COUNTED" -le 50 ]]; then
  echo "✔ The phrase turn is the TOPMOST minimap rectangle (all $COUNTED msgs load on open)."
else
  echo "⚠ phrase turn is NOT guaranteed topmost (counted=$COUNTED, first_turn=$FIRST_TURN)."
  echo "  Pi Web loads only the last 50 counted messages on open — use -n 50 or a later phrase."
fi
[[ -n "$DROPPED" && "$DROPPED" -gt 0 ]] && \
  echo "  (cut $DROPPED counted messages from the session's end to fit the budget)"

echo "Pi Web folder: $IMPORT_PROJECT"
echo "Refresh Pi Web (${PI_WEB_URL}) — the import appears within ~30 s."
