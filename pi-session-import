#!/usr/bin/env bash
# pi-session-import — put a pi session starting at a chosen point into Pi Web.
#
# Same search flow as pi-session-html, but instead of HTML it writes a trimmed
# copy of the session (active branch, from the first entry matching the phrase
# onward) into ~/.pi/agent/sessions/--imports--/ — which Pi Web scans for
# sessions. Refresh Pi Web and it appears within ~30 s.
#
# Usage:
#   pi-session-import "phrase"      # search, pick, confirm, import, open Pi Web
#   pi-session-import "phrase" -y   # no prompts (first match, no confirm)
#   pi-session-import "phrase" -n   # don't open the browser afterwards
set -euo pipefail

SESSIONS_DIR="${HOME}/.pi/agent/sessions"
IMPORT_DIR="${SESSIONS_DIR}/--imports--"
PI_WEB_URL="http://127.0.0.1:30141"
AUTO=0
OPEN=1
PHRASE=""

for arg in "$@"; do
  case "$arg" in
    -y|--yes)  AUTO=1 ;;
    -n|--no-open) OPEN=0 ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *) if [[ -z "$PHRASE" && "$arg" != -* ]]; then PHRASE="$arg"; fi ;;
  esac
done

if [[ -z "$PHRASE" ]]; then
  sed -n '2,14p' "$0"
  exit 1
fi

# ── 1. Search ────────────────────────────────────────────────────────────────
echo "Searching sessions for: \"$PHRASE\" …"
MATCHES=()
while IFS= read -r m; do MATCHES+=("$m"); done < <(grep -rilF --include='*.jsonl' -e "$PHRASE" "$SESSIONS_DIR" 2>/dev/null | sort || true)

if [[ ${#MATCHES[@]} -eq 0 ]]; then
  echo "No session contains \"$PHRASE\"."
  exit 1
fi

# ── 2. List matches, pick one ────────────────────────────────────────────────
snippet() {  # snippet <file> — first context around the phrase
  python3 - "$1" "$PHRASE" <<'PY'
import json, sys
path, phrase = sys.argv[1], sys.argv[2].lower()
with open(path, errors="replace") as f:
    for line in f:
        if phrase not in line.lower():
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue
        msg = e.get("message", {})
        role = msg.get("role", e.get("type", "?"))
        content = msg.get("content")
        texts = []
        if isinstance(content, str):
            texts.append(content)
        elif isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "text":
                    texts.append(b.get("text", ""))
        blob = "\n".join(texts).replace("\n", " ")
        i = blob.lower().find(phrase)
        if i >= 0:
            s, a = max(0, i - 50), min(len(blob), i + len(phrase) + 60)
            print(f"      …{blob[s:a]}…  [{role}]")
            break
PY
}

if [[ ${#MATCHES[@]} -eq 1 ]] && [[ $AUTO -eq 1 ]]; then
  PICK=0
else
  echo
  echo "Found ${#MATCHES[@]} session(s):"
  for i in "${!MATCHES[@]}"; do
    f="${MATCHES[$i]}"
    date=$(basename "$f" | cut -c1-19 | tr 'T' ' ')
    size=$(du -h "$f" | cut -f1 | tr -d ' ')
    printf "  [%d] %s   (%s)\n" $((i + 1)) "$date" "$size"
    snippet "$f"
  done
  echo
  if [[ $AUTO -eq 1 ]]; then
    PICK=0
    echo "(auto-picking first match)"
  else
    read -rp "Which session? [1-${#MATCHES[@]}, Enter=1, q=quit] " ans
    [[ "${ans:-1}" =~ ^[qQ]$ ]] && exit 0
    PICK=$(( ${ans:-1} - 1 ))
    if (( PICK < 0 || PICK >= ${#MATCHES[@]} )); then
      echo "Invalid choice."; exit 1
    fi
  fi
fi
FILE="${MATCHES[$PICK]}"
echo
echo "Selected: $FILE"

# ── 3. Confirm ───────────────────────────────────────────────────────────────
if [[ $AUTO -eq 0 ]]; then
  read -rp "Import into Pi Web starting at \"$PHRASE\"? [Y/n] " yn
  [[ "${yn:-y}" =~ ^[nN] ]] && exit 0
fi

# ── 4. Build trimmed session and drop it into Pi Web's sessions folder ──────
OUT=$(python3 - "$FILE" "$PHRASE" "$IMPORT_DIR" <<'PY'
import json, os, re, sys, uuid

src, phrase, import_dir = sys.argv[1], sys.argv[2], sys.argv[3]
needle = phrase.lower()

entries = []
with open(src, errors="replace") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            entries.append(json.loads(line))
        except Exception:
            continue

# active branch: walk from the last entry back through parentId
by_id = {e.get("id"): e for e in entries if e.get("id")}
last = next((e for e in reversed(entries) if e.get("id")), None)
chain, cur, seen = [], last, set()
while cur and cur.get("id") not in seen:
    seen.add(cur.get("id"))
    chain.append(cur)
    cur = by_id.get(cur.get("parentId"))
chain.reverse()

# start at the first active-branch entry containing the phrase
start = 0
for i, e in enumerate(chain):
    if needle in json.dumps(e).lower():
        start = i
        break
else:
    print("(phrase not on active branch — importing the whole session)", file=sys.stderr)

picked = chain[start:]

header = next((dict(e) for e in entries if e.get("type") == "session"),
              {"type": "session", "version": 3})
header["id"] = str(uuid.uuid4())
header["timestamp"] = picked[0].get("timestamp") or header.get("timestamp")
header.setdefault("cwd", os.path.expanduser("~"))
header.pop("parentSessionPath", None)
header["name"] = "IMPORT: " + phrase.strip()[:60]

first = dict(picked[0])
first["parentId"] = None
out_entries = [header, first] + picked[1:]

os.makedirs(import_dir, exist_ok=True)
slug = re.sub(r"[^\w.-]+", "-", phrase.strip()[:40]).strip("-.") or "session"
date_part = os.path.basename(src)[:19]
out_path = os.path.join(import_dir, f"{date_part}_import-{slug}.jsonl")
with open(out_path, "w", encoding="utf-8") as w:
    for e in out_entries:
        w.write(json.dumps(e, ensure_ascii=False) + "\n")

n_msgs = sum(1 for e in out_entries if e.get("type") == "message")
print(out_path)
print(f"entries: {len(out_entries)} ({n_msgs} messages), starting {picked[0].get('timestamp','?')}", file=sys.stderr)
PY
)

# first printed line is the path, rest is stderr info
OUT_PATH=$(echo "$OUT" | head -1)
echo "$OUT" | tail -n +2 >&2
echo "Imported: $OUT_PATH"

# ── 5. Open Pi Web ───────────────────────────────────────────────────────────
if [[ $OPEN -eq 1 ]]; then
  echo "Opening ${PI_WEB_URL} (the session appears after Pi Web rescans, up to ~30 s — refresh if needed)"
  if command -v open >/dev/null 2>&1; then
    open "$PI_WEB_URL"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$PI_WEB_URL"
  fi
else
  echo "Open ${PI_WEB_URL} and refresh — the import appears within ~30 s."
fi
